✅ Step 4: Build the Real-Time AI Assistant Pipeline (Full Integration)
Objective:
Combine all previous steps into a single, real-time system that:
1.	Continuously monitors a region of your screen.
2.	Detects new questions (e.g., during a quiz or interview).
3.	Sends the question to your local AI (Phi-3 via Ollama).
4.	Displays the AI’s answer in a private, non-intrusive overlay—only you can see it.
This will run entirely offline on your machine.
________________________________________
🔧 Key Design Choices
•	Polling loop: Checks screen every 2–3 seconds (adjustable).
•	Change detection: Only processes text if it’s new (avoids spamming AI).
•	Threading: Keeps UI responsive while AI works.
•	Privacy: No data leaves your computer.

💻 Step 4 Code: ai_screen_assistant.py
Create a new file: ai_screen_assistant.py

import threading
import time
import requests
from screen_ocr import capture_and_ocr  # From Step 1
from overlay_display import AnswerOverlay  # From Step 3

# Configuration
MONITOR_REGION = {"top": 200, "left": 300, "width": 700, "height": 200}  # ADJUST TO YOUR NEEDS
POLL_INTERVAL = 3.0  # Seconds between screen checks
LAST_SEEN_TEXT = ""
OVERLAY = None

def generate_ai_response(prompt: str) -> str:
    """Sends prompt to local Ollama (Phi-3) and returns response."""
    try:
        response = requests.post(
            "http://localhost:11434/api/generate",
            json={
                "model": "phi3",
                "prompt": f"Answer concisely: {prompt}",
                "stream": False,
                "options": {"temperature": 0.2, "num_ctx": 512}
            },
            timeout=60
        )
        if response.status_code == 200:
            return response.json().get("response", "").strip()
        else:
            return "[AI Error] Failed to generate response."
    except Exception as e:
        return f"[AI Offline] {str(e)}"

def ai_worker(question: str):
    """Runs in background thread to avoid freezing overlay."""
    global OVERLAY
    OVERLAY.update_text("🤖 Thinking...")
    answer = generate_ai_response(question)
    OVERLAY.update_text(f"❓ {question}\n\n💡 {answer}")

def main_loop():
    global LAST_SEEN_TEXT, OVERLAY
    print("🔍 Starting AI Screen Assistant (Press Ctrl+C to quit)...")
    
    while True:
        try:
            # Step 1: Capture and extract text
            current_text = capture_and_ocr(MONITOR_REGION)
            
            # Skip if no text or unchanged
            if not current_text or current_text == LAST_SEEN_TEXT:
                time.sleep(POLL_INTERVAL)
                continue

            # New question detected!
            LAST_SEEN_TEXT = current_text
            print(f"\n✅ New question detected:\n{current_text}\n")

            # Step 2+3: Generate response and show in overlay
            thread = threading.Thread(target=ai_worker, args=(current_text,))
            thread.daemon = True
            thread.start()

            time.sleep(POLL_INTERVAL)

        except KeyboardInterrupt:
            print("\n🛑 Shutting down...")
            break
        except Exception as e:
            print(f"[Loop Error] {e}")
            time.sleep(POLL_INTERVAL)

if __name__ == "__main__":
    # Initialize overlay (Step 3)
    OVERLAY = AnswerOverlay(x=50, y=50, width=500, height=200)
    try:
        from overlay_display import enable_click_through_windows
        enable_click_through_windows(OVERLAY)
    except:
        pass

    OVERLAY.update_text("🧠 AI Assistant Ready\nMonitoring screen...")
    OVERLAY.show()

    # Start main loop
    try:
        main_loop()
    except KeyboardInterrupt:
        pass
    finally:
        OVERLAY.root.destroy()

